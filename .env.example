APP_NAME=VidNotes
APP_VERSION=2.0.0

# Auth — sign in users and sign JWTs. Change JWT_SECRET to a long random value.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRE_MINUTES=1440
COOKIE_NAME=access_token

# Public base URL used to build absolute links (e.g. the email verification link).
APP_BASE_URL=http://localhost:8000

# Email verification via SMTP (Hostinger: smtp.hostinger.com, port 465 SSL or 587 STARTTLS).
# Leave SMTP_HOST empty to disable email verification (accounts are auto-verified).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=you@yourdomain.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_USE_SSL=true
EMAIL_VERIFY_TOKEN_MINUTES=1440
PASSWORD_RESET_TOKEN_MINUTES=60

WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Long audio is transcribed in overlapping chunks so progress can be streamed.
WHISPER_CHUNK_SECONDS=60
WHISPER_CHUNK_OVERLAP_SECONDS=3

TEMP_DIR=temp

MAX_VIDEO_DURATION=7200

# RAG / chat configuration
DATABASE_PATH=transcripts.db
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=5
RAG_CHUNK_CHARS=600
RAG_CHUNK_OVERLAP=60

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MAX_TOKENS=1024
